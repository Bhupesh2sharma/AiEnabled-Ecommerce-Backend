NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecommerce

CLIENT_URL=http://localhost:3000

# Number of reverse proxies in front of the app, e.g. 1 behind Nginx. Rate limits depend on this.
TRUST_PROXY=0

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
BCRYPT_SALT_ROUNDS=12
TERMS_VERSION=v1

# console prints the OTP in the server terminal (not allowed in production)
EMAIL_DRIVER=console
# Needed for EMAIL_DRIVER=resend
EMAIL_FROM=
RESEND_API_KEY=

SMS_DRIVER=console
# Needed for SMS_DRIVER=fast2sms (India only)
FAST2SMS_API_KEY=

# Image storage: r2 or s3. Upload endpoints return 503 until this is set; everything else works without it.
# Both providers can be filled in, so files on the old one can still be deleted after a switch.
STORAGE_DRIVER=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public address for images: an r2.dev address for development, a custom domain in production
R2_PUBLIC_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_URL=
# Optional, for S3-compatible servers such as MinIO
S3_ENDPOINT=

# Google login returns 503 until this is set
GOOGLE_CLIENT_ID=
