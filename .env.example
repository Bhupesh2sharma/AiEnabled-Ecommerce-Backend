NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecommerce

CLIENT_URL=http://localhost:3000

# Number of reverse proxies in front of the app, e.g. 1 behind Nginx. Rate limits depend on this.
TRUST_PROXY=0

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
BCRYPT_SALT_ROUNDS=12
TERMS_VERSION=v1

# console prints the OTP in the server terminal (not allowed in production)
EMAIL_DRIVER=console
# Needed for EMAIL_DRIVER=resend
EMAIL_FROM=
RESEND_API_KEY=

SMS_DRIVER=console
# Needed for SMS_DRIVER=fast2sms (India only)
FAST2SMS_API_KEY=

# Google login returns 503 until this is set
GOOGLE_CLIENT_ID=
