                "admins"
              ]
            },
            "description": "Creates another admin with a verified email. The first admin comes from `npm run create-admin`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Second Admin\",\n  \"email\": \"{{newAdminEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "List Seller Profiles",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
