              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "otp",
                "send"
              ]
            },
            "description": "Sends a code only to an existing account. Always returns the same 200, even if no code was sent, so the response can't reveal which accounts exist. One send per 60 seconds for each target and purpose, 5 per hour. The code prints in the server terminal until real providers are set up: copy it into the otpCode variable.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"email\",\n  \"target\": \"{{email}}\",\n  \"purpose\": \"reset_password\"\n}",
              "options": {
