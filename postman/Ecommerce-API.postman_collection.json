    {
      "name": "Seller",
      "description": "Requires a seller account with both email and phone verified.",
      "item": [
        {
          "name": "Create Store Profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/seller/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "seller",
                "profile"
              ]
            },
            "description": "Starts as `pending` until an admin reviews it. 403 `SELLER_VERIFICATION_REQUIRED` lists what's unverified in `details`. 403 `FORBIDDEN` for non-sellers. 409 if the slug is taken or a profile exists. Only `storeName`, `storeSlug` and `legalBusinessName` are required.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeName\": \"My Test Store\",\n  \"storeSlug\": \"{{storeSlug}}\",\n  \"description\": \"Test store\",\n  \"supportEmail\": \"{{email}}\",\n  \"supportPhone\": \"{{phone}}\",\n  \"businessType\": \"individual\",\n  \"legalBusinessName\": \"My Test Store Pvt Ltd\",\n  \"taxId\": \"22AAAAA0000A1Z5\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) {",
                  "  pm.collectionVariables.set('sellerProfileId', pm.response.json().profile.id);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin",
      "description": "Uses `adminAccessToken`, so it doesn't disturb a seller or customer session in `accessToken`. Run Admin Log In first.",
      "item": [
        {
          "name": "Admin Log In",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Logs in with `adminEmail` and `adminPassword` and saves `adminAccessToken`. Note the refresh cookie now belongs to the admin.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) {",
                  "  pm.collectionVariables.set('adminAccessToken', pm.response.json().accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Admin",
          "request": {
            "method": "POST",
