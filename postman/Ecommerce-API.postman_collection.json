                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/password/reset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "password",
                "reset"
              ]
            },
            "description": "Sets the new password and ends every session, so log in again afterwards. Change `newPassword` here to test a different one.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"code\": \"{{otpCode}}\",\n  \"newPassword\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Phone OTP",
      "description": "Signing up or logging in by phone. Customers and sellers only; phone numbers use E.164 format.",
      "item": [
        {
          "name": "Send Phone Login Code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/otp/send",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "otp",
                "send"
              ]
            },
            "description": "Used for both signup and login. Admin numbers get no code. Always returns the same 200, even if no code was sent, so the response can't reveal which accounts exist. One send per 60 seconds for each target and purpose, 5 per hour. The code prints in the server terminal until real providers are set up: copy it into the otpCode variable.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"phone\",\n  \"target\": \"{{phone}}\",\n  \"purpose\": \"login\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Sign Up or Log In With Phone Code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/otp/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "otp",
                "login"
              ]
            },
            "description": "New number: creates the account and returns 201 (`name` and `termsAccepted` are required, otherwise 400 `SIGNUP_DETAILS_REQUIRED` and the code stays usable). Existing number: logs in and returns 200, ignoring the signup fields.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"phone\",\n  \"target\": \"{{phone}}\",\n  \"code\": \"{{otpCode}}\",\n  \"name\": \"{{name}}\",\n  \"role\": \"{{role}}\",\n  \"termsAccepted\": true,\n  \"marketingOptIn\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) {",
                  "  pm.collectionVariables.set('accessToken', pm.response.json().accessToken);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Google",
      "description": "Google sign-in. Needs `GOOGLE_CLIENT_ID` in the backend's .env (503 `GOOGLE_NOT_CONFIGURED` otherwise) and a real Google ID token in the `googleIdToken` variable.",
      "item": [
        {
          "name": "Sign Up or Log In With Google",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/google",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "google"
              ]
            },
            "description": "New user: creates a verified account and returns 201 (`termsAccepted: true` required, otherwise 400 `TERMS_REQUIRED`). Existing user: logs in and returns 200; `role` is ignored. Admins get 403.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"{{googleIdToken}}\",\n  \"role\": \"{{role}}\",\n  \"termsAccepted\": true,\n  \"marketingOptIn\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) {",
                  "  pm.collectionVariables.set('accessToken', pm.response.json().accessToken);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
