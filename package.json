{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js up",
    "migrate:status": "node --env-file-if-exists=.env scripts/migrate.js status",
    "migrate:create": "node scripts/migrate.js create",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "keywords": [],
